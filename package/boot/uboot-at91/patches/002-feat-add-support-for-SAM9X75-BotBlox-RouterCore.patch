+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2026 Microchip Technology Inc. and its subsidiaries
+ *
+ * Author: Ryan Wanner <ryan.wanner@microchip.com>
+ */
+
+#include <asm/io.h>
+#include <asm/arch/at91sam9_smc.h>
+#include <asm/arch/at91_common.h>
+#include <asm/arch/at91_rstc.h>
+#include <asm/arch/at91_sfr.h>
+#include <asm/arch/clk.h>
+#include <asm/arch/gpio.h>
+#include <debug_uart.h>
+#include <asm/mach-types.h>
+#include <init.h>
+#include <linux/delay.h>
+#include <dt-bindings/mfd/atmel-flexcom.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+void at91_prepare_cpu_var(void);
+
+int board_late_init(void)
+{
+	at91_prepare_cpu_var();
+
+	return 0;
+}
+
+#if (IS_ENABLED(CONFIG_DEBUG_UART_BOARD_INIT))
+static void board_dbgu0_hw_init(void)
+{
+	/* FLEXCOM7 IO0 */
+	at91_pio3_set_c_periph(AT91_PIO_PORTC, 0, 1);
+	/* FLEXCOM7 IO1 */
+	at91_pio3_set_c_periph(AT91_PIO_PORTC, 1, 1);
+
+	at91_periph_clk_enable(ATMEL_ID_FLEXCOM7);
+
+	writel(ATMEL_FLEXCOM_MODE_USART, (void __iomem *)ATMEL_BASE_FLEXCOM7);
+}
+
+void board_debug_uart_init(void)
+{
+	board_dbgu0_hw_init();
+}
+#endif
+
+int board_early_init_f(void)
+{
+	return 0;
+}
+
+int board_init(void)
+{
+	/* address of boot parameters */
+	gd->bd->bi_boot_params = gd->bd->bi_dram[0].start + 0x100;
+
+	return 0;
+}
+
+#if (IS_ENABLED(CONFIG_MISC_INIT_R))
+int misc_init_r(void)
+{
+	return 0;
+}
+#endif
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
