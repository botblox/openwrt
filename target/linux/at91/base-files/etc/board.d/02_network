. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in

botblox,sam9x75-routercore)
	ucidef_set_interface "lan" \
		device "lan2 lan3 lan4 lan5 lan6 lan7 lan8 lan9 lan10 lan11 lan12 lan13 lan14 lan15 lan16 sfp1 sfp2 sfp3" \
		protocol "static" \
		ipaddr "192.168.2.1" \
		netmask "255.255.255.0"
	ucidef_set_interface_wan "lan1"
	ucidef_set_root_password_hash '$6$BotBloxRouterCor$ptkojvDJjWTbT2rHyiAntokM2lWrz5TLt9.RKiQ6jnsypYp0zbPmSQJ8HPH.Oj3VREyW2XAca0d6MJ2cQMqFN.'
	;;

atmel,sama5d3-xplained|microchip,sama7g5ek)
	ucidef_set_interfaces_lan_wan "eth0" "eth1"
	;;

*)
	ucidef_set_interface_lan "eth0"
	;;

esac

ucidef_set_interface "debug" \
	device "usb0" \
	protocol "static" \
	ipaddr "172.18.0.18" \
	netmask "255.255.255.0"

board_config_flush

exit 0
