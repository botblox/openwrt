From 1e7f7d4958d06f9a03db18b3451a72e7874e045a Mon Sep 17 00:00:00 2001
From: Aaron Elijah <aaronzakelijah@googlemail.com>
Date: Wed, 9 Sep 2026 15:31:39 -0400
Subject: [PATCH] feat: add support for SAM9X75 BotBlox RouterCore

---
 arch/arm/boot/dts/microchip/Makefile          |    1 +
 .../dts/microchip/at91-sam9x75_routercore.dts |  790 +++++++++
 arch/arm/boot/dts/microchip/sam9x7.dtsi       | 1410 +++++++++++++++++
 3 files changed, 2201 insertions(+)
 create mode 100644 arch/arm/boot/dts/microchip/at91-sam9x75_routercore.dts
 create mode 100644 arch/arm/boot/dts/microchip/sam9x7.dtsi

diff --git a/arch/arm/boot/dts/microchip/Makefile b/arch/arm/boot/dts/microchip/Makefile
index 0c45c8d17..605a00639 100644
--- a/arch/arm/boot/dts/microchip/Makefile
+++ b/arch/arm/boot/dts/microchip/Makefile
@@ -60,6 +60,7 @@ dtb-$(CONFIG_SOC_AT91SAM9) += \
 dtb-$(CONFIG_SOC_SAM9X60) += \
 	at91-sam9x60_curiosity.dtb \
 	at91-sam9x60ek.dtb
+dtb-$(CONFIG_SOC_SAM9X7) += at91-sam9x75_routercore.dtb
 dtb-$(CONFIG_SOC_SAM_V7) += \
 	at91-kizbox2-2.dtb \
 	at91-kizbox3-hs.dtb \
diff --git a/arch/arm/boot/dts/microchip/at91-sam9x75_routercore.dts b/arch/arm/boot/dts/microchip/at91-sam9x75_routercore.dts
new file mode 100644
index 000000000..94c814d9f
--- /dev/null
+++ b/arch/arm/boot/dts/microchip/at91-sam9x75_routercore.dts
@@ -0,0 +1,790 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * at91-sam9x75_routercore.dts - Device Tree file for BotBlox SAM9X75 RouterCore board
+ *
+ * Copyright (C) 2026 BotBlox Inc. and its subsidiaries
+ *
+ * Author: Aaron Elijah aaron@botblox.com>
+ */
+/dts-v1/;
+#include "sam9x7.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "BotBlox SAM9X75 RouterCore";
+	compatible = "microchip,sam9x75-routercore", "microchip,sam9x7", "atmel,at91sam9";
+
+	aliases {
+		serial0 = &uart7;
+		serial1 = &uart12;
+		i2c0 = &i2c0;
+		i2c1 = &i2c11;
+		ethernet0 = &gmac;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	led-controller {
+		compatible = "gpio-leds";
+		
+	};
+
+	memory {
+		reg = <0x20000000 0x10000000>;
+		device_type = "memory";
+	};
+
+	sfp1: sfp1 {
+		compatible = "sff,sfp";
+	};
+
+	sfp2: sfp2 {
+		compatible = "sff,sfp";
+	};
+
+	sfp3: sfp3 {
+		compatible = "sff,sfp";
+	};
+
+	/* Fixed 1.8 V rail supplying the Wi-Fi SDIO interface. */
+	wifi_vio: regulator-wifi-vio {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi-vio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	/*
+	 * TI driver convention: model nRESET as an enable supply.
+	 * PA21 high releases reset through D7; low asserts reset.
+	 */
+	wifi_en: regulator-wifi-enable {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi-enable";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&wifi_vio>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi_reset>;
+
+		gpio = <&pioA 21 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		/* Conservative initial allowance for R103/C196. */
+		startup-delay-us = <250000>;
+		off-on-delay-us = <10000>;
+	};
+};
+
+&dbgu {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_dbgu_default>;
+	status = "okay";
+};
+
+&dma0 {
+	status = "okay";
+};
+
+&ebi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_ebi_addr_nand &pinctrl_ebi_data_0_7>;
+	status = "okay";
+
+	nand_controller: nand-controller {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_nand_oe_we &pinctrl_nand_cs &pinctrl_nand_rb>;
+		status = "okay";
+
+		nand@2 {
+			reg = <0x2 0x0 0x800000>;
+			rb-gpios = <&pioD 14 GPIO_ACTIVE_HIGH>;
+			cs-gpios = <&pioD 4 GPIO_ACTIVE_HIGH>;
+			nand-bus-width = <8>;
+			nand-ecc-mode = "hw";
+			nand-ecc-strength = <8>;
+			nand-ecc-step-size = <512>;
+			nand-on-flash-bbt;
+			label = "atmel_nand";
+		};
+	};
+};
+
+&ehci0 {
+	status = "okay";
+};
+
+&can1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_can1_default>;
+	status = "okay";
+};
+
+&flx0 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
+	status = "okay";
+
+	i2c0: i2c@600 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_flx0_default>;
+		i2c-analog-filter;
+		i2c-digital-filter;
+		i2c-digital-filter-width-ns = <35>;
+		clock-frequency = <100000>;
+		status = "okay";
+
+		tps23881: ethernet-pse@20 {
+			compatible = "ti,tps23881";
+			reg = <0x20>;
+			status = "disabled";
+
+			/* 
+			* Rev B: INT and RESET are not connected to the CPU. No interrupts or reset-gpios properties
+			* are given here therefore. This requires a driver supporting operation without IRQ or
+			* it should be disabled.
+			*
+			*/
+
+			channels {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				tps_ch0: channel@0 { 
+					reg = <0>;
+				};
+
+				tps_ch1: channel@1 {
+					reg = <1>;
+				};
+
+				tps_ch2: channel@2 {
+					reg = <2>;
+				};
+
+				tps_ch3: channel@3 {
+					reg = <3>;
+				};
+
+				tps_ch4: channel@4 {
+					reg = <4>;
+				};
+
+				tps_ch5: channel@5 {
+					reg = <5>;
+				};
+
+				tps_ch6: channel@6 {
+					reg = <6>;
+				};
+
+				tps_ch7: channel@7 {
+					reg = <7>;
+				};
+			};
+
+			pse-pis {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				/* Right switch port 8: CH1 + CH2 */ 
+				poe_r8: pse-pi@0 {
+					#pse-cells = <0>;
+					reg = <0>;
+					pairset-names = "alternative-a", "alternative-b";
+					pairsets = <&tps_ch1>, <&tps_ch0>;
+				};
+
+				/* Right switch port 7: CH3 + CH4 */
+				poe_r7: pse-pi@1 {
+					#pse-cells = <0>;
+					reg = <1>;
+					pairset-names = "alternative-a", "alternative-b";
+					pairsets = <&tps_ch3>, <&tps_ch2>;
+				};
+
+				/* Left switch port 5: CH5 + CH6 */
+				poe_l5: pse-pi@2 {
+					#pse-cells = <0>;
+					reg = <2>;
+					pairset-names = "alternative-a", "alternative-b"; 
+					pairsets = <&tps_ch5>, <&tps_ch4>;
+				};
+
+				/* Left switch port 6: CH7 + CH8 */
+				poe_l6: pse-pi@3 {
+					#pse-cells = <0>;
+					reg = <3>;
+					pairset-names = "alternative-a", "alternative-b";
+					pairset = <&tps_ch7>, <&tps_ch6>;
+				};
+			};
+		};
+	};
+};
+
+&flx2 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_USART>;
+	status = "okay";
+
+	uart2: serial@200 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_flx2_default>;
+		status = "okay";
+	};
+};
+
+&flx7 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_USART>;
+	status = "okay";
+
+	uart7: serial@200 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_flx7_default>;
+		status = "okay";
+	};
+};
+
+&flx11 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
+	status = "okay";
+
+	i2c11: i2c@600 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_flx11_default>;
+		i2c-analog-filter;
+		i2c-digital-filter;
+		i2c-digital-filter-width-ns = <35>;
+		status = "okay";
+	};
+};
+
+&flx12 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_USART>;
+	status = "okay";
+
+	uart12: serial@200 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_flx12_default>;
+		status = "okay";
+	};
+};
+
+&gmac {
+	phy-mode = "rgmii-id";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_macb0_rgmii>;
+	magic-packet;
+	status = "okay";
+	local-mac-address = [00 11 22 33 44 55];
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+	};
+
+	mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		suppress-preamble;
+		status = "okay";
+
+		switchl0: ethernet-switch@2 {
+			compatible = "marvell,mv88e6190";
+			reg = <0x02>;
+			dsa,member = <0 0>;
+			status = "okay";
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&pinctrl_switchl_irq>;
+			interrupt-parent = <&pioC>;
+			interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
+
+			mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				switchl0phy1: ethernet-phy@1 {
+					reg = <0x1>;
+				};
+
+				switchl0phy2: ethernet-phy@2 {
+					reg = <0x2>;
+				};
+
+				switchl0phy3: ethernet-phy@3 {
+					reg = <0x3>;
+				};
+
+				switchl0phy4: ethernet-phy@4 {
+					reg = <0x4>;
+				};
+
+				switchl0phy5: ethernet-phy@5 {
+					reg = <0x5>;
+					pses = <&poe_l5>;
+				};
+
+				switchl0phy6: ethernet-phy@6 {
+					reg = <0x6>;
+					pses = <&poe_l6>;
+				};
+
+				switchl0phy7: ethernet-phy@7 {
+					reg = <0x7>;
+				};
+
+				switchl0phy8: ethernet-phy@8 {
+					reg = <0x8>;
+				};
+			};
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@1 {
+					reg = <0x1>;
+					label = "lan1";
+					phy-handle = <&switchl0phy1>;
+				};
+
+				port@2 {
+					reg = <0x2>;
+					label = "lan2";
+					phy-handle = <&switchl0phy2>;
+				};
+			
+				port@3 {
+					reg = <0x3>;
+					label = "lan3";
+					phy-handle = <&switchl0phy3>;
+				};
+
+				port@4 {
+					reg = <0x4>;
+					label = "lan4";
+					phy-handle = <&switchl0phy4>;
+				};
+
+				port@5 {
+					reg = <0x5>;
+					label = "lan5";
+					phy-handle = <&switchl0phy5>;
+				};
+
+				port@6 {
+					reg = <0x6>;
+					label = "lan6";
+					phy-handle = <&switchl0phy6>;
+				};
+
+				port@7 {
+					reg = <0x7>;
+					label = "lan7";
+					phy-handle = <&switchl0phy7>;
+				};
+
+				port@8 {
+					reg = <0x8>;
+					label = "lan8";
+					phy-handle = <&switchl0phy8>;
+				};
+
+				switchl0port9: port@9 {
+					reg = <0x9>;
+					label = "dsa";
+					phy-mode = "xaui";
+					link = <&switchr0port9>;
+
+					fixed-link {
+						speed = <10000>;
+						full-duplex;
+					};
+				};
+
+				switchl0port10: port@a {
+					reg = <0xa>;
+					label = "sfp1";
+					phy-mode = "10gbase-r";
+					managed = "in-band-status";
+					sfp = <&sfp1>;
+				};
+
+				switchl0port0: port@0 {
+					reg = <0x0>;
+					label = "sfp2";
+					phy-mode = "10gbase-r";
+					managed = "in-band-status";
+					sfp = <&sfp2>;
+				};
+			};
+		};
+
+		switchr0: ethernet-switch@4 {
+			compatible = "marvell,mv88e6190";
+			reg = <0x04>;
+			dsa,member = <0 1>;
+			status = "okay";
+
+			pinctrl-names = "default";
+			pinctrl-0 = <&pinctrl_switchr_irq>;
+			interrupt-parent = <&pioC>;
+			interrupts = <22 IRQ_TYPE_LEVEL_LOW>;
+
+			mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				switchr0phy1: ethernet-phy@1 {
+					reg = <0x1>;
+				};
+
+				switchr0phy2: ethernet-phy@2 {
+					reg = <0x2>;
+				};
+
+				switchr0phy3: ethernet-phy@3 {
+					reg = <0x3>;
+				};
+
+				switchr0phy4: ethernet-phy@4 {
+					reg = <0x4>;
+				};
+
+				switchr0phy5: ethernet-phy@5 {
+					reg = <0x5>;
+				};
+
+				switchr0phy6: ethernet-phy@6 {
+					reg = <0x6>;
+				};
+
+				switchr0phy7: ethernet-phy@7 {
+					reg = <0x7>;
+					pses = <&poe_r7>;
+				};
+
+				switchr0phy8: ethernet-phy@8 {
+					reg = <0x8>;
+					pses = <&poe_r8>;
+				};
+			};
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@1 {
+					reg = <0x1>;
+					label = "lan9";
+					phy-handle = <&switchr0phy1>;
+				};
+
+				port@2 {
+					reg = <0x2>;
+					label = "lan10";
+					phy-handle = <&switchr0phy2>;
+				};
+			
+				port@3 {
+					reg = <0x3>;
+					label = "lan11";
+					phy-handle = <&switchr0phy3>;
+				};
+
+				port@4 {
+					reg = <0x4>;
+					label = "lan12";
+					phy-handle = <&switchr0phy4>;
+				};
+
+				port@5 {
+					reg = <0x5>;
+					label = "lan13";
+					phy-handle = <&switchr0phy5>;
+				};
+
+				port@6 {
+					reg = <0x6>;
+					label = "lan14";
+					phy-handle = <&switchr0phy6>;
+				};
+
+				port@7 {
+					reg = <0x7>;
+					label = "lan15";
+					phy-handle = <&switchr0phy7>;
+				};
+
+				port@8 {
+					reg = <0x8>;
+					label = "lan16";
+					phy-handle = <&switchr0phy8>;
+				};
+
+				switchr0port9: port@9 {
+					reg = <0x9>;
+					label = "dsa";
+					phy-mode = "10gbase-r";
+					link = <&switchl0port9>;
+
+					fixed-link {
+						speed = <10000>;
+						full-duplex;
+					};
+				};
+
+				switchr0port10: port@a {
+					reg = <0xa>;
+					label = "sfp3";
+					phy-mode = "10gbase-r";
+					managed = "in-band-status";
+					sfp = <&sfp3>;
+				};
+
+				switchr0port0: port@0 {
+					reg = <0x0>;
+					label = "cpu";
+					ethernet = <&gmac>;
+					phy-mode = "rgmii-id";
+					fixed-link { 
+						speed = <1000>;
+						full-duplex;
+					};
+				};
+			};
+		};
+	};
+};
+
+&sdmmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_sdmmc0_default &pinctrl_wifi_irq>;
+
+	bus-width = <4>;
+	non-removable;
+	no-sd;
+	no-mmc;
+
+	cap-sd-highspeed;
+	cap-power-off-card;
+	keep-power-in-suspend;
+
+ 	max-frequency = <25000000>;
+
+	vmmc-supply = <&wifi_en>;
+	vqmmc-supply = <&wifi_vio>;
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "disabled";
+
+	wifi: wifi@2 {
+		compatible = "ti,cc33xx";
+		reg = <2>;
+
+		interrupt-parent = <&pioA>;
+		interrupts = <18 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
+
+&main_xtal {
+	clock-frequency = <24000000>;
+};
+
+&slow_xtal {
+	clock-frequency = <32768>;
+};
+
+&pinctrl {
+	dbgu {
+		pinctrl_dbgu_default: dbgu-default {
+			atmel,pins = <AT91_PIOA 26 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>,
+				      <AT91_PIOA 27 AT91_PERIPH_A AT91_PINCTRL_NONE>;
+		};
+	};
+
+	gmac {
+		pinctrl_macb0_rgmii: gmac-rgmii-default {
+			atmel,pins =
+				<AT91_PIOB 13 AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_TX0   */
+				AT91_PIOB 14 AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_TX1   */
+				AT91_PIOB 4  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_TX2   */
+				AT91_PIOB 5  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_TX3   */
+				AT91_PIOB 7  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_TXCTL  */
+				AT91_PIOB 6  AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_SLEWRATE_DIS)	/* ETH_TXCK  */
+
+				AT91_PIOB 11 AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RX0   */
+				AT91_PIOB 12 AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RX1   */
+				AT91_PIOB 0  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RX2   */
+				AT91_PIOB 1  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RX3   */
+				AT91_PIOB 8  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RXCK   */
+				AT91_PIOB 3  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS				/* ETH_RXCTL */
+
+				AT91_PIOB 10 AT91_PERIPH_A     AT91_PINCTRL_NONE				/* ETH_MDC   */
+				AT91_PIOB 9  AT91_PERIPH_A     AT91_PINCTRL_NONE				/* ETH_MDIO  */
+
+				AT91_PIOB 2  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS			/* ETH_125CK */
+				AT91_PIOD 5  AT91_PERIPH_A  AT91_PINCTRL_SLEWRATE_DIS>;			/* ETH_INT   */
+		};
+	};
+
+	switch-irqs {
+		pinctrl_switchl_irq: switchl-irq {
+			atmel,pins = <AT91_PIOC 20 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
+		};
+		pinctrl_switchr_irq: switchr-irq {
+			atmel,pins = <AT91_PIOC 22 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
+		};
+	};
+	
+	ebi {
+		pinctrl_ebi_data_0_7: ebi-data-lsb-0 {
+			atmel,pins =
+				<AT91_PIOD 6 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 7 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 8 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 9 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 10 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 11 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 12 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 13 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>;
+		};
+
+		pinctrl_ebi_addr_nand: ebi-addr-0 {
+			atmel,pins =
+				<AT91_PIOD 2 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 3 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>;
+		};
+	};
+
+	can1 {
+		pinctrl_can1_default: can1-default {
+			atmel,pins = 
+				<AT91_PIOA 28 AT91_PERIPH_B AT91_PINCTRL_PULL_UP>,		/* CAN1 Tx */
+				<AT91_PIOA 29 AT91_PERIPH_B AT91_PINCTRL_PULL_UP>;		/* CAN1 Rx */
+		};
+	};
+
+	flexcom {
+		pinctrl_flx0_default: flx0-default {
+			atmel,pins = 
+				<AT91_PIOA 30 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>,
+				<AT91_PIOA 31 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>;
+		};
+
+		pinctrl_flx2_default: flx2-default {
+			atmel,pins = 
+				<AT91_PIOA 13 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>,
+				<AT91_PIOA 14 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>;
+		};
+
+		pinctrl_flx7_default: flx7-default {
+			atmel,pins =
+				<AT91_PIOC 0 AT91_PERIPH_C AT91_PINCTRL_PULL_UP>,
+				<AT91_PIOC 1 AT91_PERIPH_C AT91_PINCTRL_PULL_UP>;
+		};
+
+		pinctrl_flx11_default: flx11-default {
+			atmel,pins =
+				<AT91_PIOB 15 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>,
+				<AT91_PIOB 16 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>;
+		};
+
+		pinctrl_flx12_default: flx12-default {
+			atmel,pins =
+				<AT91_PIOB 17 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>,
+				<AT91_PIOB 18 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>;
+		};
+	};
+
+	gpio-keys {
+		pinctrl_key_gpio_default: key-gpio-default {
+			atmel,pins = <AT91_PIOC 9 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
+		};
+	};
+
+	nand {
+		pinctrl_nand_oe_we: nand-oe-we-0 {
+			atmel,pins =
+				<AT91_PIOD 0 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>,
+				<AT91_PIOD 1 AT91_PERIPH_A (AT91_PINCTRL_NONE | AT91_PINCTRL_SLEWRATE_DIS)>;
+		};
+
+		pinctrl_nand_rb: nand-rb-0 {
+			atmel,pins =
+				<AT91_PIOD 14 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP>;
+		};
+
+		pinctrl_nand_cs: nand-cs-0 {
+			atmel,pins =
+				<AT91_PIOD 4 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP>;
+		};
+	};
+
+	sdmmc0 {
+		pinctrl_sdmmc0_default: sdmmc0-default {
+			atmel,pins =
+				<AT91_PIOA 2 AT91_PERIPH_A (AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>,					/* PA2 CK  periph A with pullup */
+				<AT91_PIOA 1 AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>,		/* PA1 CMD periph A with pullup */
+				<AT91_PIOA 0 AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>,		/* PA0 DAT0 periph A */
+				<AT91_PIOA 3 AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>,		/* PA3 DAT1 periph A with pullup */
+				<AT91_PIOA 4 AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>,		/* PA4 DAT2 periph A with pullup */
+				<AT91_PIOA 5 AT91_PERIPH_A (AT91_PINCTRL_PULL_UP | AT91_PINCTRL_DRIVE_STRENGTH_HI | AT91_PINCTRL_SLEWRATE_ENA)>;	/* PA5 DAT3 periph A with pullup */
+		};
+	};
+
+	wifi {
+		pinctrl_wifi_reset: wifi-reset {
+			atmel,pins =
+				<AT91_PIOA 21 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
+		};
+
+		pinctrl_wifi_irq: wifi-irq {
+			atmel,pins =
+				<AT91_PIOA 18 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
+		};
+	};
+}; /* pinctrl */
+
+&rtt {
+	atmel,rtt-rtc-time-reg = <&gpbr 0x0>;
+};
+
+&shutdown_controller {
+	atmel,shdwc-debouncer = <976>;
+	status = "okay";
+
+	input@0 {
+		reg = <0>;
+	};
+};
+
+&tcb {
+	timer0: timer@0 {
+		compatible = "atmel,tcb-timer";
+		reg = <0>;
+	};
+
+	timer1: timer@1 {
+		compatible = "atmel,tcb-timer";
+		reg = <1>;
+	};
+};
+
+&trng {
+	status = "okay";
+};
+
+&watchdog {
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/microchip/sam9x7.dtsi b/arch/arm/boot/dts/microchip/sam9x7.dtsi
