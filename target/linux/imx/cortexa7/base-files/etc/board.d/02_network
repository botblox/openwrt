. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case "$board" in
technexion,imx7d-pico-pi)
	ucidef_set_interface_lan "eth0"
	;;
botblox,ruggedsom)
	ucidef_set_interface "lan" device "lan1 lan2 lan3 lan4" protocol "static" ipaddr "192.168.2.1" netmask "255.255.255.0"
	ucidef_set_interface "wan" device "lan5" protocol "dhcp"
	;;
*)
	ucidef_set_interface_lan "eth0"
	;;
esac

board_config_flush

exit 0
