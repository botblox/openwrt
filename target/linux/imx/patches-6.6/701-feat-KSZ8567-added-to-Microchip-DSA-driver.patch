From eaabbbeebd4317cd60e8b2758fb1d84af39df406 Mon Sep 17 00:00:00 2001
From: AaronElijah <aaronzakelijah@googlemail.com>
Date: Fri, 7 Mar 2025 16:27:43 +0000
Subject: [PATCH 2/2] feat: KSZ8567 added to Microchip DSA driver

---
 .../bindings/net/dsa/microchip,ksz.yaml       |  1 +
 drivers/net/dsa/microchip/ksz9477_i2c.c       |  4 ++
 drivers/net/dsa/microchip/ksz_common.c        | 40 +++++++++++++++++++
 drivers/net/dsa/microchip/ksz_common.h        |  2 +
 drivers/net/dsa/microchip/ksz_spi.c           |  6 +++
 net/dsa/port.c                                |  1 +
 6 files changed, 54 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/dsa/microchip,ksz.yaml b/Documentation/devicetree/bindings/net/dsa/microchip,ksz.yaml
index 03b5567be389..c7047d64385e 100644
--- a/Documentation/devicetree/bindings/net/dsa/microchip,ksz.yaml
+++ b/Documentation/devicetree/bindings/net/dsa/microchip,ksz.yaml
@@ -27,6 +27,7 @@ properties:
       - microchip,ksz9477
       - microchip,ksz9897
       - microchip,ksz9896
+      - microchip,ksz8567
       - microchip,ksz9567
       - microchip,ksz8565
       - microchip,ksz9893
diff --git a/drivers/net/dsa/microchip/ksz9477_i2c.c b/drivers/net/dsa/microchip/ksz9477_i2c.c
index 2710afad4f3a..ee2a2ea5c2a2 100644
--- a/drivers/net/dsa/microchip/ksz9477_i2c.c
+++ b/drivers/net/dsa/microchip/ksz9477_i2c.c
@@ -106,6 +106,10 @@ static const struct of_device_id ksz9477_dt_ids[] = {
 		.compatible = "microchip,ksz8563",
 		.data = &ksz_switch_chips[KSZ8563]
 	},
+	{
+		.compatible = "microchip,ksz8567",
+		.data = &ksz_switch_chips[KSZ8567]
+	},
 	{
 		.compatible = "microchip,ksz9567",
 		.data = &ksz_switch_chips[KSZ9567]
diff --git a/drivers/net/dsa/microchip/ksz_common.c b/drivers/net/dsa/microchip/ksz_common.c
index 997c225dfba4..5be8feb221e3 100644
--- a/drivers/net/dsa/microchip/ksz_common.c
+++ b/drivers/net/dsa/microchip/ksz_common.c
@@ -1396,6 +1396,38 @@ const struct ksz_chip_data ksz_switch_chips[] = {
 		.gbit_capable = {true, true, true},
 	},
 
+	[KSZ8567] = {
+		.chip_id = KSZ8567_CHIP_ID,
+		.dev_name = "KSZ8567",
+		.num_vlans = 4096,
+		.num_alus = 4096,
+		.num_statics = 16,
+		.cpu_ports = 0x7F,	/* can be configured as cpu port */
+		.port_cnt = 7,		/* total physical port count */
+		.port_nirqs = 3,
+		.num_tx_queues = 4,
+		.tc_cbs_supported = true,
+		.tc_ets_supported = true,
+		.ops = &ksz9477_dev_ops,
+		.mib_names = ksz9477_mib_names,
+		.mib_cnt = ARRAY_SIZE(ksz9477_mib_names),
+		.reg_mib_cnt = MIB_COUNTER_NUM,
+		.regs = ksz9477_regs,
+		.masks = ksz9477_masks,
+		.shifts = ksz9477_shifts,
+		.xmii_ctrl0 = ksz9477_xmii_ctrl0,
+		.xmii_ctrl1 = ksz9477_xmii_ctrl1,
+		.supports_mii	= {false, false, false, false,
+				   false, true, true},
+		.supports_rmii	= {false, false, false, false,
+				   false, true, true},
+		.supports_rgmii = {false, false, false, false,
+				   false, true, true},
+		.internal_phy	= {true, true, true, true,
+				   true, false, false},
+		.gbit_capable	= {false, false, false, false, false, true, true},
+	},
+
 	[KSZ9567] = {
 		.chip_id = KSZ9567_CHIP_ID,
 		.dev_name = "KSZ9567",
@@ -2604,6 +2636,7 @@ static enum dsa_tag_protocol ksz_get_tag_protocol(struct dsa_switch *ds,
 	if (dev->chip_id == KSZ9477_CHIP_ID ||
 	    dev->chip_id == KSZ9896_CHIP_ID ||
 	    dev->chip_id == KSZ9897_CHIP_ID ||
+		dev->chip_id == KSZ8567_CHIP_ID ||
 	    dev->chip_id == KSZ9567_CHIP_ID)
 		proto = DSA_TAG_PROTO_KSZ9477;
 
@@ -2711,6 +2744,7 @@ static int ksz_max_mtu(struct dsa_switch *ds, int port)
 	case KSZ8563_CHIP_ID:
 	case KSZ9477_CHIP_ID:
 	case KSZ9563_CHIP_ID:
+	case KSZ8567_CHIP_ID:
 	case KSZ9567_CHIP_ID:
 	case KSZ9893_CHIP_ID:
 	case KSZ9896_CHIP_ID:
@@ -2737,6 +2771,7 @@ static int ksz_validate_eee(struct dsa_switch *ds, int port)
 	case KSZ8563_CHIP_ID:
 	case KSZ9477_CHIP_ID:
 	case KSZ9563_CHIP_ID:
+	case KSZ8567_CHIP_ID:
 	case KSZ9567_CHIP_ID:
 	case KSZ9893_CHIP_ID:
 	case KSZ9896_CHIP_ID:
@@ -2809,6 +2844,10 @@ static void ksz_set_xmii(struct ksz_device *dev, int port,
 		break;
 	case PHY_INTERFACE_MODE_RMII:
 		data8 |= bitval[P_RMII_SEL];
+		/* For RMII interface, set RMII Normal Mode */
+		/* KSZ switches that expect RMII clock input should uncomment this line */
+		/* A better way to enable this is to add a rmii_normal_mode flag to struct ksz_port*/
+		data8 |= 0x04;
 		break;
 	case PHY_INTERFACE_MODE_GMII:
 		data8 |= bitval[P_GMII_SEL];
@@ -3078,6 +3117,7 @@ static int ksz_switch_detect(struct ksz_device *dev)
 		case KSZ9477_CHIP_ID:
 		case KSZ9896_CHIP_ID:
 		case KSZ9897_CHIP_ID:
+		case KSZ8567_CHIP_ID:
 		case KSZ9567_CHIP_ID:
 		case LAN9370_CHIP_ID:
 		case LAN9371_CHIP_ID:
diff --git a/drivers/net/dsa/microchip/ksz_common.h b/drivers/net/dsa/microchip/ksz_common.h
index a4de58847dea..7ff5e1501e45 100644
--- a/drivers/net/dsa/microchip/ksz_common.h
+++ b/drivers/net/dsa/microchip/ksz_common.h
@@ -183,6 +183,7 @@ enum ksz_model {
 	KSZ9897,
 	KSZ9893,
 	KSZ9563,
+	KSZ8567,
 	KSZ9567,
 	LAN9370,
 	LAN9371,
@@ -202,6 +203,7 @@ enum ksz_chip_id {
 	KSZ9897_CHIP_ID = 0x00989700,
 	KSZ9893_CHIP_ID = 0x00989300,
 	KSZ9563_CHIP_ID = 0x00956300,
+	KSZ8567_CHIP_ID = 0x00856700,
 	KSZ9567_CHIP_ID = 0x00956700,
 	LAN9370_CHIP_ID = 0x00937000,
 	LAN9371_CHIP_ID = 0x00937100,
diff --git a/drivers/net/dsa/microchip/ksz_spi.c b/drivers/net/dsa/microchip/ksz_spi.c
index 279338451621..59a5d3553db4 100644
--- a/drivers/net/dsa/microchip/ksz_spi.c
+++ b/drivers/net/dsa/microchip/ksz_spi.c
@@ -167,6 +167,10 @@ static const struct of_device_id ksz_dt_ids[] = {
 		.compatible = "microchip,ksz8563",
 		.data = &ksz_switch_chips[KSZ8563]
 	},
+	{
+		.compatible = "microchip,ksz8567",
+		.data = &ksz_switch_chips[KSZ8567]
+	},
 	{
 		.compatible = "microchip,ksz9567",
 		.data = &ksz_switch_chips[KSZ9567]
@@ -207,6 +211,7 @@ static const struct spi_device_id ksz_spi_ids[] = {
 	{ "ksz9893" },
 	{ "ksz9563" },
 	{ "ksz8563" },
+	{ "ksz8567" },
 	{ "ksz9567" },
 	{ "lan9370" },
 	{ "lan9371" },
@@ -237,6 +242,7 @@ MODULE_ALIAS("spi:ksz9897");
 MODULE_ALIAS("spi:ksz9893");
 MODULE_ALIAS("spi:ksz9563");
 MODULE_ALIAS("spi:ksz8563");
+MODULE_ALIAS("spi:ksz8567");
 MODULE_ALIAS("spi:ksz9567");
 MODULE_ALIAS("spi:lan937x");
 MODULE_AUTHOR("Tristram Ha <Tristram.Ha@microchip.com>");
diff --git a/net/dsa/port.c b/net/dsa/port.c
index 37ab238e8304..2965a6d328ba 100644
--- a/net/dsa/port.c
+++ b/net/dsa/port.c
@@ -1919,6 +1919,7 @@ static const char * const dsa_switches_apply_workarounds[] = {
 	"microchip,ksz9893",
 	"microchip,ksz9563",
 	"microchip,ksz8563",
+	"microchip,ksz8567",
 	"microchip,ksz9567",
 #endif
 #if IS_ENABLED(CONFIG_NET_DSA_SMSC_LAN9303_MDIO)
-- 
2.48.1

